# ==============================================================================
# PR Sentinel — Environment Configuration
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
# In production, provide these variables via your orchestrator / secrets manager.
# NEVER commit the actual .env file or credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GitHub Integration & Authentication
# ------------------------------------------------------------------------------
# GitHub Personal Access Token (PAT) with repo & pull_request permissions.
# Fine-grained PAT: Read/Write access to Pull requests, Contents, and Commit statuses.
# Classic PAT: 'repo' scope.
GITHUB_TOKEN=ghp_your_github_personal_access_token_here

# Secret string configured in GitHub repository/org webhook settings.
# Used to verify HMAC-SHA256 signature on every inbound webhook payload.
GITHUB_WEBHOOK_SECRET=your_actual_secret

# Base URL for GitHub REST API (defaults to https://api.github.com).
GITHUB_API_BASE=https://api.github.com

# HTTP timeout in seconds for GitHub API calls.
GITHUB_REQUEST_TIMEOUT=15.0

# ------------------------------------------------------------------------------
# 2. LLM Provider (Groq)
# ------------------------------------------------------------------------------
# API key from Groq Console (https://console.groq.com/keys).
GROQ_API_KEY=gsk_your_groq_api_key_here

# LLM model hosted on Groq for PR code diff analysis.
# Supported models: llama-3.3-70b-versatile, llama-3.1-70b-versatile, etc.
GROQ_MODEL=llama-3.1-8b-instant

# ------------------------------------------------------------------------------
# 3. Database & Persistence (PostgreSQL)
# ------------------------------------------------------------------------------
# Async SQLAlchemy database URL for durable job queue and idempotency tracking.
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://postgres@127.0.0.1:25432/pr_sentinel

# ------------------------------------------------------------------------------
# 4. Worker Concurrency, Leases & Retries
# ------------------------------------------------------------------------------
# Worker execution mode:
#   "hybrid"  - Web server runs webhook receiver + in-process worker loop + immediate task (default)
#   "server"  - Web server only enqueues jobs to DB; dedicated worker processes handle execution
#   "worker"  - Dedicated worker process (run via python -m app.worker)
WORKER_MODE=hybrid

# Maximum lease duration (in seconds) before an in_progress job is considered stale/abandoned.
JOB_LEASE_TIMEOUT=300.0

# Maximum retry attempts allowed per review job before marking as permanently failed.
MAX_JOB_ATTEMPTS=3

# Base backoff delay (in seconds) for exponential backoff on retries: base_delay * (2 ^ (attempt - 1)).
JOB_RETRY_BASE_DELAY=2.0

# Polling interval (in seconds) for worker idle loop when looking for queued/retryable jobs.
JOB_POLL_INTERVAL=1.0

# Interval (in seconds) at which active workers refresh their lease heartbeat during pipeline execution.
WORKER_HEARTBEAT_INTERVAL=10.0

# Maximum grace period (in seconds) for in-flight jobs to complete during graceful worker shutdown.
WORKER_SHUTDOWN_TIMEOUT=15.0

# ------------------------------------------------------------------------------
# 5. Review Behavior & Limits
# ------------------------------------------------------------------------------
# Maximum number of changed files to inspect per pull request.
MAX_FILES_TO_REVIEW=15

# Maximum patch size in bytes per file to prevent LLM context overflows.
MAX_PATCH_BYTES=20000

# Minimum confidence threshold (0.0 - 1.0) for reporting findings.
MIN_CONFIDENCE_THRESHOLD=0.7

# Whether to submit an official GitHub Pull Request Review (verdict + inline comments).
# If set to false, posts individual issue comments instead.
SUBMIT_OFFICIAL_PR_REVIEW=true

# Maximum inline diff comments posted in a single batch review to prevent GitHub API rejections.
# Overflow comments beyond this limit are cleanly summarized in the main review markdown body.
MAX_INLINE_COMMENTS_PER_REVIEW=25

# Whether to publish commit status checks (pr-sentinel/review) on the PR head commit.
ENABLE_COMMIT_STATUS=false

# ------------------------------------------------------------------------------
# 6. Operational & Admin Endpoints Security
# ------------------------------------------------------------------------------
# Administrative API key protecting operational endpoints:
#   - GET  /jobs/{job_id}
#   - POST /jobs/{job_id}/retry
#   - GET  /jobs/stats
# When set, clients must supply the 'X-Admin-Key: <key>' HTTP header.
# If left empty (""), admin endpoints are accessible without header authentication (dev mode only).
ADMIN_API_KEY=your_secure_admin_api_key_here

# ------------------------------------------------------------------------------
# 7. Codebase-Aware Retrieval (Phase 7)
# ------------------------------------------------------------------------------
# Whether to enable cross-file repository context retrieval for changed PR files.
ENABLE_CODEBASE_RETRIEVAL=true

# Maximum number of external repository files to retrieve context from per PR review.
MAX_RETRIEVED_FILES=5

# Maximum snippet size in bytes per retrieved symbol definition to prevent prompt bloat.
MAX_RETRIEVED_SNIPPET_BYTES=2000

# Maximum total context bytes retrieved across all files combined per PR review.
MAX_TOTAL_RETRIEVAL_BYTES=8000
